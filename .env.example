# Copy to .env (never commit .env — it is in .gitignore). docker compose reads it automatically.
#
# Live AI: set ONE key. Without any key the app runs in clearly-labelled demo mode
# (rule-based extraction and template messages, no network calls).
# Keys are read only by the Node server and are never sent to the browser.

# OpenAI — the key provided by the hackathon organisers (models: gpt-6-luna)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Alternative: Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Optional: force a provider (openai | anthropic | demo). Default: OpenAI if its key is set, else Anthropic, else demo.
AI_PROVIDER=

# Optional: host port for docker compose (the container always listens on 8080).
TWINSYNC_PORT=8080
