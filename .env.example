# Copy to .env (never commit .env). docker compose reads it automatically.

# Optional: enables live AI extraction of preferences/constraints from owner text.
# Leave empty to run in demo mode (deterministic Greek keyword rules, no network calls).
# The key is only read by the Node server; it is never sent to the browser.
ANTHROPIC_API_KEY=

# Optional: model used for extraction.
ANTHROPIC_MODEL=claude-opus-5-5

# Optional: host port for docker compose (container always listens on 8080).
TWINSYNC_PORT=8080
