# Copy to .env (never commit .env — it is in .gitignore). docker compose reads it automatically.
#
# Live AI: set ONE key. Without any key the app runs in clearly-labelled demo mode
# (rules, a small synthetic option catalog and template messages, no network calls).
# Keys are read only by the Node server and are never sent to the browser.

# OpenAI — the key provided by the hackathon organisers (gpt-6-luna + text-embedding-3-large)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Alternative: Anthropic Claude (retrieval then uses keywords instead of embeddings)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Optional: force a provider (openai | anthropic | demo). Default: OpenAI if its key is set, else Anthropic, else demo.
AI_PROVIDER=

# Optional: OpenAI reasoning effort (none | low | medium | high | xhigh | default). "low" ~30s per group request.
AI_REASONING_EFFORT=low

# Optional: safety cap on model calls per data volume (protects the token budget).
AI_MAX_CALLS=600

# Optional: host port for docker compose (the container always listens on 8080).
TWINSYNC_PORT=8080
